# AWS
AWS_REGION=ap-southeast-1
S3_BUCKET=crypto-data-platform-raw-example

# Binance
BINANCE_BASE_URL=https://api.binance.com
REQUEST_TIMEOUT=10
MAX_RETRIES=3

# Data lake storage
S3_RAW_PREFIX=raw
S3_BRONZE_PREFIX=bronze
S3_SILVER_PREFIX=silver
S3_QUARANTINE_PREFIX=quarantine

# Logging
LOG_LEVEL=INFO
