crypto_data_platform:
  target: dev
  outputs:
    dev:
      type: redshift
      host: "{{ env_var('DBT_REDSHIFT_HOST') }}"
      port: "{{ env_var('DBT_REDSHIFT_PORT', '5439') | int }}"
      dbname: "{{ env_var('DBT_REDSHIFT_DBNAME', 'crypto_warehouse') }}"
      user: "{{ env_var('DBT_REDSHIFT_USER') }}"
      password: "{{ env_var('DBT_ENV_SECRET_REDSHIFT_PASSWORD') }}"
      schema: "{{ env_var('DBT_REDSHIFT_SCHEMA', 'analytics') }}"
      threads: 2
      connect_timeout: 10
      sslmode: verify-full
