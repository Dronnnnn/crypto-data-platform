# AWS
AWS_REGION=ap-southeast-1
S3_BUCKET=crypto-data-platform-raw-example

# Binance
BINANCE_BASE_URL=https://api.binance.com
REQUEST_TIMEOUT=10
MAX_RETRIES=3

# Data lake storage
S3_RAW_PREFIX=raw
S3_BRONZE_PREFIX=bronze
S3_SILVER_PREFIX=silver
S3_QUARANTINE_PREFIX=quarantine

# dbt / Redshift. Keep real connection values only in a local .env file.
DBT_REDSHIFT_HOST=
DBT_REDSHIFT_PORT=5439
DBT_REDSHIFT_DBNAME=crypto_warehouse
DBT_REDSHIFT_USER=adminuser
DBT_ENV_SECRET_REDSHIFT_PASSWORD=
DBT_REDSHIFT_SCHEMA=analytics

# Logging
LOG_LEVEL=INFO

# Generated locally by scripts/bootstrap.py. Do not reuse demo keys.
AIRFLOW_UID=50000
FERNET_KEY=
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=
